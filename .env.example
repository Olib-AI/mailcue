# MailCue Configuration
# Copy to .env and customize as needed

# Domain for email addresses (user@DOMAIN)
MAILCUE_DOMAIN=mailcue.local

# Default admin account
MAILCUE_ADMIN_USER=admin
MAILCUE_ADMIN_PASSWORD=mailcue

# JWT secret key (leave empty to auto-generate at first boot)
MAILCUE_SECRET_KEY=

# SQLCipher encryption key for the SQLite database (AES-256 at rest).
# Leave empty to use unencrypted SQLite (default).
# When set on an existing unencrypted DB, it will be auto-converted on next startup.
MAILCUE_DATABASE_ENCRYPTION_KEY=

# Database backend. SQLite remains the zero-configuration default.
# For PostgreSQL, either set a complete URL:
# MAILCUE_DATABASE_URL=postgresql+psycopg://mailcue:password@db.example.com:5432/mailcue?sslmode=verify-full
# Or configure the connection as individual values:
MAILCUE_DATABASE_BACKEND=sqlite
MAILCUE_DATABASE_HOST=
MAILCUE_DATABASE_PORT=5432
MAILCUE_DATABASE_USER=
MAILCUE_DATABASE_PASSWORD=
MAILCUE_DATABASE_NAME=mailcue
MAILCUE_DATABASE_SSLMODE=prefer
# Set true only for PostgreSQL on a private, unexposed container network.
MAILCUE_DATABASE_ALLOW_INSECURE_PRIVATE_NETWORK=false

# PostgreSQL connection pool and timeout tuning.
MAILCUE_DATABASE_POOL_SIZE=10
MAILCUE_DATABASE_MAX_OVERFLOW=20
MAILCUE_DATABASE_POOL_TIMEOUT=30
MAILCUE_DATABASE_POOL_RECYCLE=1800
MAILCUE_DATABASE_CONNECT_TIMEOUT=10
MAILCUE_DATABASE_STATEMENT_TIMEOUT_MS=30000

# IMAP master user (used by API to access all mailboxes)
MAILCUE_IMAP_MASTER_USER=mailcue-master
# Required in production. Generate independently with: openssl rand -hex 32
MAILCUE_IMAP_MASTER_PASSWORD=

# Cross-origin access is disabled by default. Same-origin UI access needs no entry.
MAILCUE_CORS_ORIGINS=[]
# Email validation. Unknown SMTP results fail closed. When using the MailCue
# tunnel overlay, its compose file configures the validation relay automatically.
MAILCUE_VALIDATION_SMTP_PROBE_ENABLED=true
MAILCUE_VALIDATION_SMTP_TIMEOUT_SECONDS=8
# Optional sidecar status endpoint used by Settings > Tunnels.
MAILCUE_TUNNEL_METRICS_URL=http://mailcue-sidecar:9325
# Hard end-to-end budget; keep below the SDK's default 30-second timeout.
MAILCUE_VALIDATION_TOTAL_TIMEOUT_SECONDS=25
MAILCUE_VALIDATION_PROBE_RELAY_HOST=
MAILCUE_VALIDATION_PROBE_RELAY_PORT=2525
MAILCUE_VALIDATION_RATE_LIMIT=30/minute
