#!/command/with-contenv sh
# =============================================================================
# Uvicorn — FastAPI application server
# =============================================================================
exec 2>&1

# Read the auto-generated secret key if MAILCUE_SECRET_KEY was not set
if [ -z "${MAILCUE_SECRET_KEY}" ] && [ -f /var/lib/mailcue/.secret_key ]; then
    export MAILCUE_SECRET_KEY
    MAILCUE_SECRET_KEY=$(cat /var/lib/mailcue/.secret_key)
fi

# Preserve an explicitly configured URL or host-based PostgreSQL settings.
# Only synthesize the historical SQLite URL for zero-configuration installs.
case "${MAILCUE_DATABASE_BACKEND:-sqlite}" in
    postgres|postgresql) USE_CONFIGURED_DATABASE=true ;;
    *) USE_CONFIGURED_DATABASE=false ;;
esac
if [ -z "${MAILCUE_DATABASE_URL:-}" ] \
    && [ -z "${MAILCUE_DATABASE_HOST:-}" ] \
    && [ "${USE_CONFIGURED_DATABASE}" = "false" ]; then
    export MAILCUE_DATABASE_URL="sqlite+aiosqlite:///${MAILCUE_DB_PATH:-/var/lib/mailcue/mailcue.db}"
fi

cd /opt/mailcue

exec /opt/mailcue/venv/bin/uvicorn \
    app.main:app \
    --host 127.0.0.1 \
    --port 8000 \
    --workers 1 \
    --log-level info \
    --no-access-log
